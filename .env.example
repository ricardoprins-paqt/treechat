# Copy this file to .env and adjust as needed. .env is gitignored.

# Base URL of the internal vLLM OpenAI-compatible server
LLM_BASE_URL=http://10.69.1.213:8000/v1

# Model to request from the server
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# API key sent as a Bearer token (server doesn't check it, but the header is required)
LLM_API_KEY=unused
